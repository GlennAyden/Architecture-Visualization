# Runtime
PORT=8788
AUTH_SQLITE_PATH=.data/auth.sqlite
AUTH_SESSION_DAYS=30

# Shared secret used by the Vercel web proxy. Do not expose this to browsers.
ARCHVIZ_BACKEND_PROXY_TOKEN=

# Convex JWT issuer settings. Generate key material with:
#   pnpm --filter @arch-viz/vps-api auth:keys
AUTH_JWT_ISSUER=https://your-auth-backend.example.com
AUTH_JWT_AUDIENCE=convex
AUTH_JWT_PRIVATE_KEY=
