# Runtime
PORT=8788
AUTH_SQLITE_PATH=.data/auth.sqlite
AUTH_SESSION_DAYS=30

# Shared secret used by the Vercel web proxy. Do not expose this to browsers.
ARCHVIZ_BACKEND_PROXY_TOKEN=

# Convex JWT issuer settings. Generate key material with:
#   pnpm --filter @arch-viz/vps-api auth:keys
AUTH_JWT_ISSUER=https://your-auth-backend.example.com
AUTH_JWT_AUDIENCE=convex
AUTH_JWT_PRIVATE_KEY=

# Codebase rescan target. The VPS rescan endpoint runs arch-viz-mcp from this
# repository path and refuses to run when ARCHITECTURE_PROJECT_ID does not match
# the requested canvas project.
ARCHITECTURE_REPO_PATH=/srv/expandly
ARCHITECTURE_CONVEX_URL=https://your-deployment.convex.site
ARCHITECTURE_API_KEY=archv_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ARCHITECTURE_PROJECT_ID=
ARCHITECTURE_EXPECT_PROJECT_ID=
ARCHITECTURE_EXPECT_PROJECT_NAME=

# Optional: override when the service cwd is not the Arch Viz repo root.
# ARCHVIZ_MCP_BIN=/srv/architecture-visualization/apps/mcp-server/dist/index.js
# ARCHVIZ_RESCAN_STEP_TIMEOUT_MS=900000
