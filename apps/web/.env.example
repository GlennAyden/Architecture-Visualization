# Convex client URL (auto-set by `convex dev` for local deployments)
NEXT_PUBLIC_CONVEX_URL=

# Optional explicit Convex HTTP Actions URL ending in `.convex.site`.
ARCHVIZ_CONVEX_SITE_URL=

# Vercel-to-VPS auth proxy. The backend owns SQLite sessions and JWT signing.
ARCHVIZ_AUTH_BACKEND_URL=
ARCHVIZ_AUTH_BACKEND_TOKEN=
AUTH_COOKIE_NAME=arch_viz_session
