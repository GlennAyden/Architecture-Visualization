    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "ai-agents",
    "architecture",
    "convex",
    "stdio"
  ],
  "homepage": "https://github.com/GlennAyden/Architecture-Visualization#readme",
  "bugs": {
    "url": "https://github.com/GlennAyden/Architecture-Visualization/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlennAyden/Architecture-Visualization.git",
    "directory": "apps/mcp-server"
  },
  "license": "MIT",
  "author": "GlennAyden <glennayden15@gmail.com>",
  "type": "module",
  "bin": {
    "arch-viz-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
