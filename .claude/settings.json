{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/log-activity.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/auto-link-imports.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/suggest-nodes-post-commit.mjs"
          }
        ]
      }
    ]
  }
}
